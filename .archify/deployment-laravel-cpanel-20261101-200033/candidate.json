  "cards": [
    {
      "dot": "cyan",
      "title": "Flujo de una petición web",
      "items": [
        "Usuario → DNS municipal → HTTPS/AutoSSL → Apache o LiteSpeed",
        "El VirtualHost sirve únicamente /public_html y delega index.php a PHP-FPM",
        "Laravel carga el proyecto privado, procesa la petición y usa PDO hacia MySQL local"
      ]
    },
    {
      "dot": "rose",
      "title": "Controles DevSecOps",
      "items": [
        ".env, app, config, vendor y storage no son accesibles directamente desde la web",
        "Terminal/SSH y phpMyAdmin son canales privilegiados exclusivos de OTI",
        "Las credenciales de base de datos viven en .env; no se versionan ni se exponen en public_html"
      ]
    },
    {
      "dot": "emerald",
      "title": "Operación de Laravel",
      "items": [
        "Cron de cPanel ejecuta php artisan schedule:run cada minuto",
        "php artisan storage:link publica solo storage/app/public mediante un enlace simbólico",
        "Artisan y Composer se ejecutan con el PHP CLI compatible con PHP-FPM 8.x"
      ]
    }
  ]
