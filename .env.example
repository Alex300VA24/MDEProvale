APP_NAME="Sistema PROVALE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# APP_URL:
#  - Modo `php artisan serve`:  APP_URL=http://localhost:8000 (por defecto).
#  - Modo XAMPP (subcarpeta de htdocs): APP_URL=http://localhost/NOMBRE_CARPETA/public
#    (p. ej. http://localhost/MDEProvale/public).
# Las rutas del navegador se generan de forma relativa al request igual en ambos
# modos; APP_URL se usa solo fuera del navegador (cola, consola, tests).

# Asistente PROVALE (solo backend; nunca usar una variable VITE_ para esta clave)
# Valores permitidos: google, groq o none. Cambia solo esta variable para alternar.
# El escaneo diario de normativa (normativa:scan-pvl) también usa este proveedor para
# clasificar relevancia PVL y para embeddings RAG (embeddings solo disponibles con google;
# con groq la búsqueda cae a score léxico, igual que en Reportes PVL).
AI_PROVIDER=google
# Presupuesto de salida para respuestas del asistente. Incluye el razonamiento interno de algunos modelos Gemini.
AI_CHAT_MAX_TOKENS=8192
# Reintentos del análisis estructurado ante fallos transitorios (429, 5xx, 400 json_validate_failed). 1 desactiva.
AI_STRUCTURED_RETRIES=3
# Espera base entre reintentos en ms (crece exponencialmente y respeta Retry-After del proveedor).
AI_STRUCTURED_RETRY_BASE_MS=1000

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_STRUCTURED_STRICT=true
GROQ_REPORT_MAX_TOKENS=8192

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
KB_OCR_MIN_PAGE_CHARACTERS=200

# RENIEC WS2 mediante PIDE (credenciales solo backend)
RENIEC_DNI_USUARIO=
RENIEC_RUC_USUARIO=
RENIEC_PASSWORD=
RENIEC_CONSULTAR_URL=https://ws2.pide.gob.pe/Rest/RENIEC/Consultar?out=json
RENIEC_ACTUALIZAR_URL=https://ws2.pide.gob.pe/Rest/RENIEC/Actualizar?out=json
RENIEC_CONNECT_TIMEOUT=5
RENIEC_TIMEOUT=15

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,::1,[::1]:*
SESSION_DOMAIN=

INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true
INERTIA_SSR_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP por defecto: usuario root y clave vacia. Si tu MySQL tiene clave,
# completar DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=DBSYSPROVALE
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_COOKIE=provale_session
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
